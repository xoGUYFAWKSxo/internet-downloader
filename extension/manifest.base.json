{
  "manifest_version": 3,
  "name": "Internet Downloader",
  "version": "0.0.1",
  "description": "Sends downloads and media streams to the Internet Downloader app.",
  "permissions": [
    "nativeMessaging",
    "webRequest",
    "cookies",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Internet Downloader"
  },
  "chrome": {
    "key": "",
    "background": {
      "service_worker": "background.js",
      "type": "module"
    }
  },
  "firefox": {
    "background": {
      "scripts": [
        "background.js"
      ],
      "type": "module"
    },
    "browser_specific_settings": {
      "gecko": {
        "id": "internet-downloader@xoguyfawksxo",
        "strict_min_version": "128.0",
        "data_collection_permissions": {
          "required": [
            "none"
          ]
        }
      }
    }
  },
  "host_permissions": [
    "<all_urls>"
  ]
}
