{
  "manifest_version": 3,
  "name": "Galactic Downloader",
  "version": "0.0.1",
  "description": "Sends downloads and media streams to the Galactic Downloader app.",
  "permissions": [
    "nativeMessaging",
    "webRequest",
    "cookies",
    "storage",
    "contextMenus",
    "notifications"
  ],
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Galactic Downloader",
    "default_icon": {
      "128": "icon.png"
    }
  },
  "chrome": {
    "key": "",
    "background": {
      "service_worker": "background.js",
      "type": "module"
    }
  },
  "firefox": {
    "background": {
      "scripts": [
        "background.js"
      ],
      "type": "module"
    },
    "browser_specific_settings": {
      "gecko": {
        "id": "internet-downloader@xoguyfawksxo",
        "strict_min_version": "140.0",
        "data_collection_permissions": {
          "required": [
            "authenticationInfo",
            "browsingActivity",
            "websiteContent"
          ]
        }
      }
    }
  },
  "host_permissions": [
    "<all_urls>"
  ]
}
